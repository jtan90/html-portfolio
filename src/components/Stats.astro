---
const stats = [
  { countTo: 8, suffix: '+', label: 'Years experience' },
  { countTo: 4, suffix: '', label: 'Enterprise companies' },
  { countTo: 8, suffix: '', label: 'Products shipped' },
  { countTo: 100, suffix: 'k+', label: 'Users impacted' },
];
---

<section class="border-y border-neutral-800/60">
  <div class="max-w-6xl mx-auto px-6 py-14 grid grid-cols-2 md:grid-cols-4 gap-8">
    {
      stats.map((s) => (
        <div data-reveal>
          <div class="text-3xl md:text-4xl font-semibold tracking-tight text-neutral-100">
            <span data-count-to={s.countTo}>0</span>{s.suffix}
          </div>
          <div class="mt-1 text-sm text-neutral-500 uppercase tracking-wider">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>
